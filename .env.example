# Suplook Server Configuration

# Required: Anthropic API key for Claude Vision
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: Google Places API for photo hunting
GOOGLE_API_KEY=your_google_api_key_here

# Optional: Yelp Fusion API for restaurant photos
YELP_API_KEY=your_yelp_api_key_here

# Authentication keys
AUTH_KEY=your_auth_key_here
ADMIN_KEY=your_admin_key_here

# Server port (default: 3009)
PORT=3009
